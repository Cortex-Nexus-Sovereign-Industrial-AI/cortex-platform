# ============================================
# CORTEX PLATFORM v2.2 — Environment Variables
# Copy to backend/.env — never commit real secrets
# ============================================

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

DATABASE_PATH=./data/cortex.db

# REQUIRED in production — use a long random string
JWT_SECRET=change-me-to-a-long-random-secret

# Paystack — use TEST keys in development
PAYSTACK_MODE=test
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

# Shopify (optional until commerce activation)
SHOPIFY_STORE_DOMAIN=cortex-intelligence-nexus.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_your_admin_token_here

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@cortex-platform.com

LOG_LEVEL=info
