# ============================================
# CORTEX PLATFORM — Environment Configuration
# CINIS NEXUS INDUSTRY OGOJA
# ============================================
# NEVER commit real values. Copy to .env locally.
# .env is gitignored.

# Paystack
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key_here
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret_here
PAYSTACK_MODE=test

# Shopify
SHOPIFY_STORE_DOMAIN=cortex-intelligence-nexus.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_your_admin_token_here

# Auth / sessions
JWT_SECRET=change-me-to-a-long-random-secret
SECRET_KEY=change-me-session-secret

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Optional secondary gateway
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_PUBLIC_KEY=
