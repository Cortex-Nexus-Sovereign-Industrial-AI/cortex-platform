{
  "skill_id": "cortex-realtime-voice",
  "version": "0.2.0",
  "status": "real-providers-ready",
  "realtime": {
    "sample_rate": 24000,
    "channels": 1,
    "encoding": "pcm16",
    "vad": {
      "enabled": true,
      "mode": "server",
      "silence_threshold_ms": 600
    },
    "barge_in": true,
    "max_turn_duration_ms": 30000
  },
  "providers": {
    "stt": {
      "provider": "deepgram",
      "model": "nova-2",
      "language": "en",
      "env_key": "DEEPGRAM_API_KEY"
    },
    "llm": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "temperature": 0.7,
      "env_key": "OPENAI_API_KEY"
    },
    "tts": {
      "provider": "openai",
      "model": "tts-1",
      "voice": "alloy",
      "speed": 1.0,
      "env_key": "OPENAI_API_KEY"
    }
  },
  "session": {
    "max_history_turns": 20,
    "ttl_ms": 1800000,
    "system_prompt_path": "system-prompt.md"
  },
  "server": {
    "port": 8787,
    "path": "/"
  }
}
