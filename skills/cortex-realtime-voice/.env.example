# Cortex Realtime Voice – Environment Variables
# Copy to .env and fill in real keys (never commit .env)

# Required for real STT
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Required for real LLM + TTS
OPENAI_API_KEY=your_openai_api_key_here

# Optional overrides
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=alloy
PORT=8787
